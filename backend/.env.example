# ---------------------------------------------------------------
# Copy this file's contents into a new file named ".env"
# (same folder). Never share ".env" or upload it anywhere.
# ---------------------------------------------------------------

# Port the backend listens on
PORT=5001

# Your free key from https://newsapi.org/register
NEWS_API_KEY=2466a488b29144f2b3ef269b813f87a5

# MongoDB connection string. Leave EMPTY for now - the app works without it.
# Later it will look like: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/frontpage
MONGODB_URI=

# Website address(es) allowed to call this server (comma-separated)
CLIENT_URL=http://localhost:5173

# Country for the Business and Science tabs: us, gb, in, au, ca ...
NEWS_COUNTRY=us

# How many minutes to reuse saved headlines before asking NewsAPI again
CACHE_MINUTES=15